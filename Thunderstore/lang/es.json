      "value": "Balas"
    },
    {
      "key": "value.Display.BarStyle.Ichor",
      "value": "Tinta"
    },
    {
      "key": "value.Display.BarStyle.Bone",
      "value": "Hueso"
    },
    {
      "key": "value.Display.BarStyle.Classic",
      "value": "Clásico"
    },
    {
      "key": "entry.Display.MaxDistance.name",
      "value": "Distancia máxima"
    },
    {
      "key": "entry.Display.MaxDistance.description",
      "value": "Distancia máxima en metros a la que se muestra una barra."
    },
    {
      "key": "entry.Display.BarScale.name",
      "value": "Tamaño de barra"
    },
    {
      "key": "entry.Display.BarScale.description",

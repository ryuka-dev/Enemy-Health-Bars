      "value": "Modo de visualización"
    },
    {
      "key": "entry.Display.DisplayMode.description",
      "value": "Heridos muestra una barra durante unos segundos después de que un enemigo pierda vida. Cercanos muestra una barra en cada enemigo visible dentro del alcance."
    },
    {
      "key": "value.Display.DisplayMode.Damaged",
      "value": "Heridos"
    },

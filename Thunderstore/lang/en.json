    },
    {
      "key": "value.Display.BarStyle.Classic",
      "value": "Classic"
    },
    {
      "key": "entry.Display.MaxDistance.name",
      "value": "Max distance"
    },
    {
      "key": "entry.Display.MaxDistance.description",
      "value": "How far away a bar can still show, in meters."
    },
    {
      "key": "entry.Display.BarScale.name",
      "value": "Bar scale"
    },
    {
      "key": "entry.Display.BarScale.description",
      "value": "Size of the bars and names."
    },
    {
      "key": "entry.Display.ShowName.name",
      "value": "Show name"
    },
    {

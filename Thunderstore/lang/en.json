      "key": "entry.Display.DisplayMode.name",
      "value": "Display mode"
    },
    {
      "key": "entry.Display.DisplayMode.description",
      "value": "Damaged shows a bar for a few seconds after an enemy loses health. Nearby shows a bar on every enemy in range that you can see."
    },
    {
      "key": "value.Display.DisplayMode.Damaged",
      "value": "Damaged"

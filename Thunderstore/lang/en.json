      "value": "Bar style"
    },
    {
      "key": "entry.Display.BarStyle.description",
      "value": "Look of the bars. Sulfur matches the HUD health bar and follows its color. Rounds is a row of ten rings like the ammo gauge. Ichor is a bar of dripping ink. Bone has a skull at its left end. Classic is a plain bar."
    },
    {
      "key": "value.Display.BarStyle.Sulfur",
      "value": "Sulfur"
